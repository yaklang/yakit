    "release-link-render": "cd app/renderer/engine-link-startup && yarn release-render",
    "release-irify": "node scripts/release-irify.js",
    "release-memfit": "node scripts/release-memfit.js",
    "release-yakit": "node scripts/prod-pack.js",
    "test:vitest": "vitest",
    "perf:mitm": "MITM_PERF_PROFILE=smoke vitest bench app/renderer/src/main/src/pages/mitm/MITMManual/__test__/MITMManual.perf.bench.ts --run --maxWorkers=1",
    "perf:mitm:electron:compare": "node scripts/compare-electron-mitm-performance.mjs",
    "perf:mitm:electron:matrix-compare": "node scripts/compare-electron-mitm-matrices.mjs",
    "test:e2e:build": "run-s build-test-render-e2e build-link-render",
    "test:e2e:build:minified": "run-s build-test-render build-link-render write-test-render-minified-metadata",
    "build-test-render-e2e": "node scripts/run-bounded-e2e-renderer-build.mjs",
    "write-test-render-e2e-metadata": "node scripts/write-e2e-renderer-build-metadata.mjs production-unminified",
    "write-test-render-minified-metadata": "node scripts/write-e2e-renderer-build-metadata.mjs production-minified",
    "test:e2e:electron": "node scripts/run-electron-e2e.mjs --suite smoke",
    "test:e2e:electron:smoke": "node scripts/run-electron-e2e.mjs --suite smoke",
    "test:e2e:electron:real-engine": "node scripts/run-electron-e2e.mjs --with-yak-engine --suite real-engine",
    "test:e2e:electron:web-fuzzer-mcp": "node scripts/run-electron-e2e.mjs --with-yak-engine --suite web-fuzzer-mcp",
    "test:e2e:web-fuzzer-mcp": "run-s test:e2e:build test:e2e:preflight test:e2e:electron:web-fuzzer-mcp",
    "test:e2e:electron:mitm-performance": "node scripts/run-electron-e2e.mjs --with-yak-engine --suite mitm-performance",
    "test:e2e:electron:mitm-matrix": "node scripts/run-electron-mitm-body-matrix.mjs",
    "test:e2e:electron:mitm-matrix:repeat": "node scripts/run-electron-mitm-body-matrix.mjs --repeat 3",
    "test:e2e:electron:mitm-sustained": "node scripts/run-electron-mitm-body-matrix.mjs --matrix-file e2e/config/mitm-sustained-matrix.json",
    "test:e2e:electron:mitm-fixed-rate": "node scripts/run-electron-mitm-body-matrix.mjs --matrix-file e2e/config/mitm-fixed-rate-matrix.json",
    "test:e2e:electron:mitm-slow-consumer": "node scripts/run-electron-mitm-body-matrix.mjs --matrix-file e2e/config/mitm-slow-consumer-matrix.json --httpflow-live-stream-mode canary",
    "test:e2e:electron:mitm-compressed": "node scripts/run-electron-mitm-body-matrix.mjs --matrix-file e2e/config/mitm-compressed-matrix.json",
    "test:e2e:electron:mitm-compressed-fixed-rate": "node scripts/run-electron-mitm-body-matrix.mjs --matrix-file e2e/config/mitm-compressed-fixed-rate-matrix.json",
    "test:e2e:electron:mitm-cpu-profile": "node scripts/run-electron-mitm-body-matrix.mjs --case request-64k --cpu-profile-seconds 5",
    "test:e2e:electron:mitm-heap-profile": "node scripts/run-electron-mitm-body-matrix.mjs --case bidirectional-64k-256k --heap-profile",
    "test:e2e:electron:mitm-renderer-trace": "node scripts/run-electron-mitm-body-matrix.mjs --case bidirectional-64k-256k --renderer-trace",
    "test:e2e:electron:mitm-renderer-trace:no-system-timing": "node scripts/run-electron-mitm-body-matrix.mjs --case bidirectional-64k-256k --renderer-trace --disable-system-timing",
    "test:e2e:preflight": "vitest run app/main/__test__/e2eEnvironment.test.js e2e/fixtures/__test__/*.test.js e2e/reporters/__test__/*.test.js",
    "test:e2e:electron:local": "yarn test:e2e:build && yarn test:e2e:preflight && yarn test:e2e:electron:smoke && yarn test:e2e:electron:real-engine",
    "test:e2e:fixture": "vitest run e2e/fixtures/__test__/yak-engine-fixture.test.js",
    "i18n:check": "node scripts/locale-parity.js",
    "link-i18n:check": "cd app/renderer/engine-link-startup && yarn i18n:check",
    "ci:eslint": "cd app/renderer/src/main && yarn eslint src --ext .js,.jsx,.ts,.tsx",
    "ci:tsc": "cd app/renderer/src/main && yarn type-check",
    "ci:media-size": "node scripts/check-media-size.js",
    "prepare": "husky"
