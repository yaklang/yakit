    "build-test-renders": "run-s build-test-render build-link-render",
    "build-renders-enterprise": "run-s build-render-enterprise build-link-render-enterprise",
    "build-renders-enterprise-no-license": "run-s build-render-enterprise-no-license build-link-render-enterprise",
    "build-renders-test-enterprise": "run-s build-render-test-enterprise build-link-render-enterprise",
