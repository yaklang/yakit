    "build-link-render-enterprise": "cd app/renderer/engine-link-startup && yarn build-enterprise",
    "build-link-render-simple-enterprise": "cd app/renderer/engine-link-startup && yarn build-simple-enterprise",
    "build-link-render-irify": "cd app/renderer/engine-link-startup && yarn build-irify",
    "build-link-render-irify-enterprise": "cd app/renderer/engine-link-startup && yarn build-irify-enterprise",
    "build-link-render-memfit": "cd app/renderer/engine-link-startup && yarn build-memfit",
    "build-render": "cd app/renderer/src/main && yarn build",
    "build-test-render": "cd app/renderer/src/main && yarn build-test",
    "build-render-enterprise": "cd app/renderer/src/main && yarn build-enterprise",
    "build-render-enterprise-no-license": "cd app/renderer/src/main && yarn build-enterprise-no-license",
    "build-render-breachtrace": "cd app/renderer/src/main && yarn build-breachtrace",
