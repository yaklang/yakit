    "pack-win-memfit": "env-cmd -e nonSignNormal,Memfit -r packageScript/.env-cmdrc electron-builder build --win --config ./packageScript/electron-builder.config.js",
    "pack-win-memfit-legacy": "env-cmd -e nonSignLegacy,Memfit -r packageScript/.env-cmdrc electron-builder build --win --config ./packageScript/electron-builder.config.js",
    "pack-mac": "env-cmd -e signNormal -r packageScript/.env-cmdrc electron-builder build --mac --config ./packageScript/electron-builder.config.js",
    "pack-mac-legacy": "env-cmd -e nonSignLegacy -r packageScript/.env-cmdrc electron-builder build --mac --config ./packageScript/electron-builder.config.js",
