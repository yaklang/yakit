    "pack-mac-se-legacy": "env-cmd -e nonSignLegacy,SE -r packageScript/.env-cmdrc electron-builder build --mac --config ./packageScript/electron-builder.config.js",
    "pack-mac-irify": "env-cmd -e signNormal,IRify -r ./packageScript/.env-cmdrc electron-builder build --mac --config ./packageScript/electron-builder.config.js",
    "pack-mac-irify-legacy": "env-cmd -e nonSignLegacy,IRify -r packageScript/.env-cmdrc electron-builder build --mac --config ./packageScript/electron-builder.config.js",
    "pack-mac-irify-ee": "env-cmd -e signNormal,IRifyEE -r ./packageScript/.env-cmdrc electron-builder build --mac --config ./packageScript/electron-builder.config.js",
    "pack-mac-irify-ee-legacy": "env-cmd -e nonSignLegacy,IRifyEE -r packageScript/.env-cmdrc electron-builder build --mac --config ./packageScript/electron-builder.config.js",
