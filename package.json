{
  "name": "yakit",
  "version": "1.4.8-0814",
  "description": "Yakit is for yaklang.io Electron GUI Entry",
  "main": "app/main/index.js",
  "scripts": {
    "cli": "node ./cli/cli.mjs",
    "start-electron": "electron .",
    "install-link-render": "cd app/renderer/engine-link-startup && yarn install",
    "install-render": "cd app/renderer/src/main && yarn install",
    "check-deps": "node scripts/check-deps.js",
    "render-yarn": "cd app/renderer/src/main && yarn",
    "render-cli": "cd app/renderer/src/main && yarn cli",
    "start-link-render": "cd app/renderer/engine-link-startup && yarn electron-render",
    "start-link-render-enterprise": "cd app/renderer/engine-link-startup && yarn electron-render-enterprise",
    "start-link-render-simple-enterprise": "cd app/renderer/engine-link-startup && yarn electron-render-simple-enterprise",
    "start-link-render-irify": "cd app/renderer/engine-link-startup && yarn electron-render-irify",
    "start-link-render-irify-enterprise": "cd app/renderer/engine-link-startup && yarn electron-render-irify-enterprise",
    "start-link-render-memfit": "cd app/renderer/engine-link-startup && yarn electron-render-memfit",
    "start-render": "cd app/renderer/src/main && yarn electron-render",
    "start-render-enterprise": "cd app/renderer/src/main && yarn electron-render-enterprise",
    "start-render-simple-enterprise": "cd app/renderer/src/main && yarn electron-render-simple-enterprise",
    "start-render-irify": "cd app/renderer/src/main && yarn electron-render-irify",
    "start-render-irify-enterprise": "cd app/renderer/src/main && yarn electron-render-irify-enterprise",
    "start-render-memfit": "cd app/renderer/src/main && yarn electron-render-memfit",
    "start-renders": "concurrently \"yarn start-render\" \"yarn start-link-render\"",
    "start-renders-enterprise": "concurrently \"yarn start-render-enterprise\" \"yarn start-link-render-enterprise\"",
    "start-renders-simple-enterprise": "concurrently \"yarn start-render-simple-enterprise\" \"yarn start-link-render-simple-enterprise\"",
    "start-renders-irify": "concurrently \"yarn start-render-irify\" \"yarn start-link-render-irify\"",
    "start-renders-irify-enterprise": "concurrently \"yarn start-render-irify-enterprise\" \"yarn start-link-render-irify-enterprise\"",
    "start-renders-memfit": "concurrently \"yarn start-render-memfit\" \"yarn start-link-render-memfit\"",
