# ============================================================
# 飞书只给你一个 webhook URL，整条填进 PR_LABEL_WEBHOOK_URL 即可。
# 放到 GitHub：Settings -> Secrets and variables -> Actions -> Secrets -> New repository secret
# ============================================================

# 示例（把最后一段换成你自己的）
PR_LABEL_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/00000000-0000-0000-0000-000000000000

# ---- 可选：安全设置 ----
# 机器人详情页「安全设置」里开了签名校验才需要
PR_LABEL_SECRET=
# 开了关键词才需要（会拼到 text / 卡片标题前）
PR_LABEL_KEYWORD=
# interactive（卡片，默认）| text
PR_LABEL_MSG_TYPE=interactive

# 要通知哪些标签写在 pr-label.mjs 的 WATCH_LABELS，不在这里配。
# 匹配方式（大小写不敏感）：
#   exact    = 必须完全相等（默认；写错或留空也是这个）
#   contains = 标签名包含白名单某项即命中
#   all      = 任何标签都通知
PR_LABEL_MATCH_MODE=exact

# ---- 可选：网络与展示 ----
PR_LABEL_TIMEOUT_MS=10000
PR_LABEL_RETRIES=3
# 卡片 footer 时区，默认 Asia/Shanghai
# PR_LABEL_TZ=Asia/Shanghai

# ---- 本地调试用 ----
# 指定事件文件，不指定时自动读 GITHUB_EVENT_PATH（Actions 注入，不要改名）
# GITHUB_EVENT_PATH=./fixtures/labeled.json
