// Trusted model adapter: QClaw Message API -> Memfit text/JSON model output.
// The mock's upstream model credentials never enter this script.
chat = func(req, emit) {
	assert len(req.RawMessages) == 0, "QClaw adapter expects a complete text prompt; raw messages are not supported"
    endpoint = req.Endpoint
    if !req.EnableEndpoint || endpoint == "" {
        endpoint = str.TrimRight(req.BaseURL, "/") + "/api/v1/message"
    }
    customer = req.Params["cust_id"]
    if customer == nil || customer == "" { customer = "memfit-local" }
    payload = {
        "sessionId": req.RequestID,
        "custID": customer,
        "txt": req.Prompt,
        "executionMode": "execute",
        "stream": true,
        "debugTrace": false,
        "appHistory": [],
        "config_variables": [],
        "availableSkills": [],
    }
    options = [poc.json(payload), poc.context(req.Context), poc.timeout(req.Timeout),
        poc.retryTimes(0), poc.redirectTimes(0), poc.save(false)]
    if req.APIKey != "" {
        options = append(options, poc.replaceHeader("Authorization", "Bearer " + req.APIKey))
    }
    if req.Proxy != "" { options = append(options, poc.proxy(req.Proxy)) }
    for key, value in req.Headers {
        options = append(options, poc.replaceHeader(key, value))
    }
    // This upstream emits a single final answer, so buffer it until both the
    // business result and the terminal event have been validated.
    response, _ = poc.Post(endpoint, options...)~
    assert response.GetStatusCode() == 200, sprintf("QClaw HTTP %d", response.GetStatusCode())
    result, seenMessage, seenDone = "", false, false
    provider.ReadSSE(str.NewReader(string(response.GetBody())), func(event, data) {
        if event == "start" || event == "progress" || event == "router.progress" { return nil }
        if event == "message" {
            if seenMessage { return error("QClaw returned multiple final messages") }
            message = json.loads(data)
            if !message.ok || message.status != "completed" {
                return error(sprintf("QClaw business error: status=%v code=%v", message.status, message.errorCode))
            }
            result = message.message
            seenMessage = true
            return nil
        }
        if event == "done" {
            if data != "[DONE]" && data != `"[DONE]"` { return error("invalid QClaw done event") }
            seenDone = true
            return io.EOF
        }
        return nil
    })~
    assert seenDone && seenMessage, "QClaw response ended without a completed message and done event"
    assert str.TrimSpace(result) != "", "QClaw returned an empty answer"
    return result
}
