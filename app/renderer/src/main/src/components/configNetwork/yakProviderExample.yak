// Trusted adapter example. Contract: common/ai/yakscript/README.md.
// Public ai library (completion, hover and signatures are available in the editor):
// ai.ReadSSE(reader, callback): SSE framing only; decode event JSON in the callback.
// ai.ModelError(req, kind, status, code, message, retryAfter): report a failed attempt.
// ai.IsTransientError(err): recognize interrupted reads and temporary network errors.
// ai.Retry(reason, retryAfter) / ai.StopRetry(reason): decisions for shouldRetry.
// The host owns the retry loop. One chat invocation performs ONE HTTP request.
// req contains invocation data only: Context, RequestID, Prompt, RawMessages, Tools, ToolChoice.
// All endpoint, authentication, model and timeout choices belong to this source.
// Output: return text OR emit(text)~ and return nil; never both.
// Native calls: enable the provider switch and return {content, tool_calls, finish_reason}.
// tool_calls use {id, type:"function", function:{name, arguments:"JSON object"}}.
// The host validates all calls before delivering them; never emit raw tool JSON.
// emit accepts model content only. There is no separate reasoning emitter.
// Errors: return error(...), never error text as a successful answer.
// Set business options in this script. Rate/retry/debug are engine settings.
// Both modes buffer and validate the complete answer before returning it.
// reasoning_content is intentionally not delivered: emit only supports content.

checkProtocol = func(req, ok, message) {
    if !ok { ai.ModelError(req, "protocol", 0, "", message, "")~ }
}

// Optional: nil uses the host default. Business codes belong to the adapter.
shouldRetry = func(req, failure) {
    if failure.Kind == "business" {
        if failure.Code == "UPSTREAM_BUSY" {
            return ai.Retry("upstream temporarily busy", failure.RetryAfter)
        }
        return ai.StopRetry("inspect the upstream business error")
    }
    return nil
}

decodeObject = func(req, raw) {
    value, err = json.New(raw)
    checkProtocol(req, err == nil, "Chat Completions returned invalid JSON")
    checkProtocol(req, value.IsObject(), "Chat Completions expected a JSON object")
    return value.Value()
}

chat = func(req, emit) {
    // 1. Map the host request to this upstream's HTTP API.
    assert len(req.RawMessages) == 0, "This example accepts the complete req.Prompt only"
    mode = "json" // Change to "sse" for streaming Chat Completions.
    assert mode == "json" || mode == "sse", "response_mode must be json or sse"
    endpoint = "https://model.example/v1/chat/completions"
    model = "your-model-id"
    apiKey = ""
    timeoutSeconds = 240
    proxy = ""
    headers = {}
    native = len(req.Tools) > 0
    // This template uses complete JSON for native calls; custom SSE adapters must assemble deltas.
    if native { mode = "json" }
    payload = {
        "model": model,
        "messages": [{"role": "user", "content": req.Prompt}],
        "stream": mode == "sse",
        "n": 1,
    }
    if native {
        payload["tools"] = req.Tools
        if req.ToolChoice != nil { payload["tool_choice"] = req.ToolChoice }
    }
    options = [poc.json(payload), poc.context(req.Context), poc.timeout(timeoutSeconds),
        poc.retryTimes(0), poc.redirectTimes(0), poc.save(false)]
    if apiKey != "" {
        options = append(options, poc.replaceHeader("Authorization", "Bearer " + apiKey))
    }
    if proxy != "" { options = append(options, poc.proxy(proxy)) }
    for key, value in headers {
        options = append(options, poc.replaceHeader(key, value))
    }

    // 2. Report structured failures; aispec applies the retry policy.
    response, _, requestError = poc.Post(endpoint, options...)
    if requestError != nil {
        if ai.IsTransientError(requestError) {
            return ai.ModelError(req, "network", 0, "", "Chat Completions connection temporarily unavailable", "")
        }
        return error("Chat Completions request failed; check endpoint, proxy and TLS")
    }
    status = response.GetStatusCode()
    if status != 200 {
        return ai.ModelError(req, "http", status, "", sprintf("Chat Completions HTTP %d", status), response.GetHeader("Retry-After"))
    }
    contentType = str.ToLower(response.GetHeader("Content-Type"))
    result = ""

    // 3a. Non-streaming JSON has choices[].message, not choices[].delta.
    if mode == "json" {
        checkProtocol(req, str.HasPrefix(contentType, "application/json"), "Expected application/json")
        body = decodeObject(req, response.GetBody())
        if body["error"] != nil {
            return ai.ModelError(req, "business", status, "UPSTREAM_ERROR", "Chat Completions returned an API error", "")
        }
        choices = json.New(body["choices"])~
        checkProtocol(req, choices.IsArray() && len(body["choices"]) == 1, "Expected one completion choice")
        choice = body["choices"][0]
        checkProtocol(req, choice["message"] != nil, "Missing completion message")
        checkProtocol(req, choice["message"]["function_call"] == nil, "Legacy function_call is unsupported")
        if choice["message"]["refusal"] != nil && choice["message"]["refusal"] != "" {
            return ai.ModelError(req, "business", status, "MODEL_REFUSAL", "Model refused the request", "")
        }
        if native {
            content = choice["message"]["content"]
            if content == nil { content = "" }
            calls = choice["message"]["tool_calls"]
            if calls == nil { calls = [] }
            return {"content": content, "tool_calls": calls, "finish_reason": choice["finish_reason"]}
        }
        checkProtocol(req, choice["finish_reason"] == "stop", "Completion did not finish normally")
        checkProtocol(req, choice["message"]["tool_calls"] == nil, "Unexpected native calls in text mode")
        result = choice["message"]["content"]
    } else {
        // 3b. ReadSSE only decodes the envelope. This callback owns the LLM schema.
        checkProtocol(req, str.HasPrefix(contentType, "text/event-stream"), "Expected text/event-stream")
        seenDone, seenStop = false, false
        businessError = nil
        parseError = ai.ReadSSE(str.NewReader(string(response.GetBody())), func(event, data) {
            if event != "message" { return ai.ModelError(req, "protocol", 0, "", "Unexpected Chat Completions SSE event", "") }
            if data == "[DONE]" {
                seenDone = true
                return io.EOF
            }
            chunk = decodeObject(req, data)
            if chunk["error"] != nil {
                businessError = ai.ModelError(req, "business", status, "UPSTREAM_ERROR", "Chat Completions returned an API error", "")
                return businessError
            }
            choices = json.New(chunk["choices"])~
            if !choices.IsArray() { return ai.ModelError(req, "protocol", 0, "", "Missing completion choices", "") }
            // A usage-only chunk may follow the final choice.
            if len(chunk["choices"]) == 0 {
                if chunk["usage"] == nil { return ai.ModelError(req, "protocol", 0, "", "Unexpected empty completion choices", "") }
                return nil
            }
            if len(chunk["choices"]) != 1 || chunk["choices"][0]["index"] != 0 {
                return ai.ModelError(req, "protocol", 0, "", "Expected only completion choice zero", "")
            }
            if seenStop { return ai.ModelError(req, "protocol", 0, "", "Completion choice arrived after finish_reason", "") }
            choice = chunk["choices"][0]
            deltaObject = json.New(choice["delta"])~
            if !deltaObject.IsObject() { return ai.ModelError(req, "protocol", 0, "", "Missing completion delta object", "") }
            if choice["delta"]["tool_calls"] != nil || choice["delta"]["function_call"] != nil {
                return ai.ModelError(req, "protocol", 0, "", "Native tool calls are unsupported by this example", "")
            }
            if choice["delta"]["refusal"] != nil && choice["delta"]["refusal"] != "" {
                businessError = ai.ModelError(req, "business", status, "MODEL_REFUSAL", "Model refused the request", "")
                return businessError
            }
            // Do not mix delta.reasoning_content / reasoning into model content.
            part = choice["delta"]["content"]
            if part != nil {
                if typeof(part).String() != "string" { return ai.ModelError(req, "protocol", 0, "", "Completion content must be text", "") }
                result += part
            }
            if choice["finish_reason"] != nil {
                if choice["finish_reason"] != "stop" { return ai.ModelError(req, "protocol", 0, "", "Completion did not finish normally", "") }
                seenStop = true
            }
            return nil
        })
        if businessError != nil { return businessError }
        if parseError != nil {
            if ai.IsTransientError(parseError) {
                return ai.ModelError(req, "protocol", 0, "", "Chat Completions SSE was truncated", "")
            }
            return ai.ModelError(req, "protocol", 0, "", sprintf("SSE decode failed: %v", parseError), "")
        }
        if !seenDone || !seenStop {
            return ai.ModelError(req, "protocol", 0, "", "Chat Completions SSE missing completion markers", "")
        }
    }

    // 4. Commit only normalized, validated content. @action validation is the Agent's job.
    checkProtocol(req, result != nil && typeof(result).String() == "string", "Completion content must be text")
    checkProtocol(req, str.TrimSpace(result) != "", "Model returned an empty answer")
    return result
}
