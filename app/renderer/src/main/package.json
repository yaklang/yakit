  "scripts": {
    "cli": "node scripts/cli.js",
    "electron-render": "env-cmd -e noBrouser,devTool -f ./.env-cmdrc vite",
    "electron-render-enterprise": "env-cmd -e noBrouser,devTool,enterprise -f ./.env-cmdrc vite --mode enterprise",
    "electron-render-simple-enterprise": "env-cmd -e noBrouser,devTool,simpleEE -f ./.env-cmdrc vite --mode simpleEE",
    "electron-render-irify": "env-cmd -e noBrouser,devTool,irify -f ./.env-cmdrc vite --mode irify",
    "electron-render-irify-enterprise": "env-cmd -e noBrouser,devTool,irifyEnterprise -f ./.env-cmdrc vite --mode irifyEnterprise",
    "electron-render-memfit": "env-cmd -e noBrouser,devTool,memfit -f ./.env-cmdrc vite --mode memfit",
    "build": "cross-env GENERATE_SOURCEMAP=false vite build",
    "build-test": "env-cmd -e devTool -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build",
    "build-enterprise": "env-cmd -e enterprise -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode enterprise",
    "build-enterprise-no-license": "env-cmd -e enterprise,enterpriseNoLicense -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode enterprise",
    "build-enpritrace": "env-cmd -e enterprise -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode enterprise",
    "build-test-enterprise": "env-cmd -e enterprise,devTool -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode enterprise",
    "build-test-enterprise-no-license": "env-cmd -e enterprise,devTool,enterpriseNoLicense -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode enterprise",
    "build-simple-enterprise": "env-cmd -e simpleEE -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode simpleEE",
    "build-irify": "env-cmd -e irify -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode irify",
    "build-memfit": "env-cmd -e memfit -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode memfit",
    "build-irify-enterprise": "env-cmd -e irifyEnterprise -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode irifyEnterprise",
    "build-enpritrace-agent": "env-cmd -e simpleEE -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode simpleEE",
    "build-test-simple-enterprise": "env-cmd -e simpleEE,devTool -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode simpleEE",
    "build-test-irify": "env-cmd -e irify,devTool -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode irify",
    "build-test-irify-enterprise": "env-cmd -e irifyEnterprise,devTool -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode irifyEnterprise",
    "build-test-memfit": "env-cmd -e memfit,devTool -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode memfit",
    "build-breachtrace": "env-cmd -e breachtrace -f ./.env-cmdrc cross-env GENERATE_SOURCEMAP=false vite build --mode breachtrace",
    "test": "vitest",
    "analyzer": "cross-env REACT_APP_ANALYZER=true GENERATE_SOURCEMAP=false vite build",
    "postinstall": "patch-package",
    "release-render": "node scripts/release-render.js",
    "preview": "vite preview",
    "test:run": "vitest run",
    "verify-build-artifacts": "node scripts/verify-renderer-build-artifacts.mjs",
    "electron-render-breachtrace": "env-cmd -e noBrouser,devTool,breachtrace -f ./.env-cmdrc vite --mode breachtrace"
